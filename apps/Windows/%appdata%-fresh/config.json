    "status_bar": {
      "right": ["{line_ending}", "{encoding}", "{language}", "{lsp}"],
      "left": ["{clock}", "{git_statusbar:branch}", "{cursor:compact}"]
    },
    "completion_popup_auto_show": true,
    "tab_size": 2,
    "screensaver_enabled": true,
    "show_tilde": true
  },
  "file_explorer": {
    "show_hidden": true,
